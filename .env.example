LLM_MODEL_GPT_5_MINI=gpt-5-mini
LLM_MODEL_GPT_4_1=gpt-4.1
LLM_MODEL_GPT_4_1_MINI=gpt-4.1-mini
LLM_MODEL_GPT_4_MINI=gpt-4.1-mini
