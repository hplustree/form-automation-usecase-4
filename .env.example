# LiteLLM Configuration
LITELLM_MASTER_KEY=your_litellm_master_key_here
LLM_BASE_URL=http://localhost:4000

# LLM Models
LLM_MODEL_GPT_5=gpt-5
LLM_MODEL_GPT_5_MINI=gpt-4.1-mini
LLM_MODEL_GPT_4_MINI=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large

# Reasoning Configuration
REASONING_EFFORT=low
TEMPERATURE=0.5

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# Response Configuration
MAX_RESPONSE_TOKENS=1000
VALIDATION_MAX_ITERATIONS=3

# Weaviate Configuration
WEAVIATE_URL=http://weaviate:8080
DOC_TTL_DAYS=180

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=604800

# Worker Configuration
MAX_CONCURRENT_FIELDS=5
MAX_RETRIES=3
IMAGE_DETECTION_WORKERS=10

# Hierarchical Worker Configuration
# Set USE_HIERARCHICAL_WORKERS=true to enable hierarchical worker allocation
# In hierarchical mode:
# - Each project worker spawns NUM_DOC_WORKERS_PER_PROJECT document workers
# - Each document worker spawns NUM_FIELD_WORKERS_PER_DOC field workers
# - Workers only process tasks assigned to their parent
USE_HIERARCHICAL_WORKERS=false

# Traditional Parallel Mode (USE_HIERARCHICAL_WORKERS=false)
# Fixed worker pools shared across all projects
NUM_DOC_WORKERS=2
NUM_FIELD_WORKERS=10
NUM_PROJECT_WORKERS=1

# Hierarchical Mode (USE_HIERARCHICAL_WORKERS=true)
# Workers spawned per parent (e.g., 1 project → 2 doc workers → 5 field workers each)
NUM_DOC_WORKERS_PER_PROJECT=2
NUM_FIELD_WORKERS_PER_DOC=5

# Container Configuration
CONTAINER_ID=pipeline-worker-1

# Database Configuration
DATABASE_URL=postgresql://postgres:1234@postgres:5432/siso_pipeline
