# ===============================
# Redis Configuration
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=604800

# ===============================
# Document Processing Settings
# ===============================
CHUNK_SIZE=5000
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# ===============================
# Search and Retrieval Configuration
# ===============================
BREAKPOINT_THRESHOLD_TYPE=percentile
BREAKPOINT_THRESHOLD_AMOUNT=95
DEFAULT_RESULTS_LIMIT=20
MAX_RESULTS_LIMIT=50
FALLBACK_CHUNK_LIMIT=100
HYBRID_SCORE_THRESHOLD=0.6
CHUNK_MAX_LENGTH=50000
ENABLE_CHUNK_DETAILS=true
CONFIDENCE_THRESHOLD=0.6
MIN_CONFIDENCE_FOR_EXPLANATION=0.6
TOP_PAGES=5

# PARALLEL PROCESSING CONFIGURATION
# ===============================
# New ThreadPoolExecutor-based architecture
# NUM_PROJECT_WORKERS: Number of project workers (processes projects in parallel)
# MAX_CONCURRENT_DOCS: Max documents processed concurrently per project
# MAX_CONCURRENT_FIELDS: Max fields processed concurrently per document
NUM_PROJECT_WORKERS=3               # Number of project workers
NUM_DOCUMENT_WORKERS=2              # Number of document workers (for regeneration/add docs)
MAX_CONCURRENT_DOCS=2               # Max documents processed per project
MAX_CONCURRENT_FIELDS=5             # Max fields processed per document

# Example: 3 workers × 2 docs × 5 fields = 30 concurrent field extractions max

# ===============================
# Concurrency Control
# ===============================
MAX_CONCURRENT_PROMPTS=10           # Max concurrent LLM calls
MAX_CONCURRENT_EMBEDDINGS=15        # Max concurrent embedding calls
MAX_RETRIES=3                       # Retry attempts for failed operations
IMAGE_DETECTION_WORKERS=10          # Workers for image processing
LITELLM_NUM_WORKERS=4               # LiteLLM proxy workers

# ===============================
# HTTP Request Timeout
# ===============================
HTTP_REQUEST_TIMEOUT=30

# ===============================
# Database Configuration
# ===============================
POSTGRES_VERSION=16
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=siso_pipeline
DATABASE_URL=postgresql://postgres:1234@postgres:5432/siso_pipeline

